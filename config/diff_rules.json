{
  "pairs_priority": [
    [
      "before.txt",
      "after.txt"
    ],
    [
      "before.html",
      "after.html"
    ],
    [
      "old.txt",
      "new.txt"
    ],
    [
      "prev.txt",
      "curr.txt"
    ],
    [
      "prev.html",
      "curr.html"
    ],
    [
      "content_old.txt",
      "content_new.txt"
    ]
  ],
  "max_tokens": 200000,
  "normalize": {
    "collapse_whitespace": true,
    "strip_html_tags": true,
    "strip_common_banners": true
  }
}
