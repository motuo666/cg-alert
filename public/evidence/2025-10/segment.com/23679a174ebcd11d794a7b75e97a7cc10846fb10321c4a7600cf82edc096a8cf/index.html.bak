    <div class="richtext " data-ext-icon="&lt;svg viewBox=&#34;0 0 79 79&#34; fill=&#34;none&#34; xmlns=&#34;http://www.w3.org/2000/svg&#34; class=&#34;icon--decorative&#34; role=&#34;presentation&#34;>
