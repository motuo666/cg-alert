ACA,cAAA,CACA,wGAAA,CAEA,mBAAA,CACA,kCAAA,CACA,+DAAA,CAEA,yCAAA,CACA,+CAAA,CACA,yCAAA,CACA,qCAAA,CAEA,oCACE,uCAAA,CACA,uCAAA,CACA,uCAAA,CACA,eAAA,CACA,oBAAA,CAGF,gFAEE,uCAAA,CACA,4CAAA,CACA,uCAAA,CACA,kEAAA,CACA,eAAA,CACA,oBAAA,CAGF,qCACE,yCAAA,CACA,yCAAA,CACA,eAAA,CACA,oBAAA,CAGF,uCACE,yCAAA,CACA,yCAAA,CACA,eAAA,CACA,oBAAA,CI3DJ,UACE,WAAA,CACA,oBAAA,CJsNA,kCACE,8BAAA,CIjNJ,eJ1DE,iBAAA,CI8DF,iCACE,iBAAA,CACA,cAAA,CACA,eAAA,CACA,mBAAA,CAGF,qBACE,iBAAA,CACA,SAAA,CACA,MAAA,CACA,OAAA,CACA,gBAAA,CACA,iBAAA,CACA,6CAAA,CACA,kBAAA,CACA,WAAA,CACA,eAAA,CAGF,4BACE,iBAAA,CACA,KAAA,CACA,MAAA,CACA,OAAA,CACA,gBAAA,CACA,iBAAA,CACA,6CAAA,CACA,kBAAA,CACA,WAAA,CACA,eAAA,CACA,iBAAA,CAGF,+BACE,gBAAA",sourcesContent:["$inline-info-icon: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' fill='none' viewBox='0 0 16 16' focusable='false' class='icon-rebrand-no-fill icon-action-info undefined'><path stroke='currentColor' d='M1.333 8a6.666 6.666 0 1 0 13.333 0A6.666 6.666 0 0 0 1.333 8Z'></path><path stroke='currentColor' d='M6 7h2v4m-2 0h4M8 5.333v-1'></path></svg>\");\n$inline-alert-icon: url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' fill='none' viewBox='0 0 16 16' focusable='false' class='icon-rebrand-no-fill icon-action-alert undefined'><path stroke='currentColor' d='M1.333 8a6.666 6.666 0 1 0 13.333 0A6.666 6.666 0 0 0 1.333 8ZM8 4.667V9m0 1.333v1'></path></svg>\");\n\n@mixin notification-neutral {\n  display: flex;\n  border-radius: var(--border-r-stamp);\n  border: var(--border-b-seed) solid var(--control-border-neutral);\n  font: var(--body-xs);\n  color: var(--base-text-secondary);\n  background-color: var(--base-bg-primary);\n\n  span {\n    background-color: var(--control-bg-decorative);\n    padding: var(--layout-shoe);\n    border-radius: var(--border-r-stamp) var(--border-r-sandgrain)\n      var(--border-r-sandgrain) var(--border-r-stamp);\n    background-image: $inline-info-icon;\n    background-repeat: no-repeat;\n    background-position: center;\n    background-position-y: calc(var(--layout-stamp) + var(--layout-soybean));\n  }\n\n  div,\n  p {\n    padding: var(--layout-spoon);\n    background-color: var(--base-bg-primary);\n    border-radius: var(--border-r-sandgrain) var(--border-r-stamp)\n      var(--border-r-stamp) var(--border-r-sandgrain);\n  }\n}\n\n@mixin notification-alert {\n  border: var(--border-b-seed) solid var(--control-border-bad);\n\n  span {\n    background-color: var(--control-bg-bad-decorative);\n    background-image: $inline-alert-icon;\n  }\n}\n\n@mixin notification-warning {\n  border: var(--border-b-seed) solid var(--control-border-warn);\n\n  span {\n    background-color: var(--control-bg-warn-decorative);\n    background-image: $inline-alert-icon;\n  }\n}\n\n@mixin border-container {\n  border-radius: var(--border-r-shoe);\n  border: var(--border-b-seed) solid var(--base-border-secondary);\n}\n\n@mixin segmented-control {\n  display: flex;\n  background-color: var(--control-bg-primary);\n  border: var(--border-b-seed) solid var(--control-border-default);\n  border-radius: var(--border-r-seed);\n  overflow: hidden;\n\n  div.item {\n    flex-grow: 1;\n    min-width: var(--layout-sandgrain);\n\n    font: var(--body-xs);\n    border-bottom: var(--border-b-soybean) solid transparent;\n    color: var(--control-text-primary);\n    cursor: pointer;\n    display: flex;\n    overflow: hidden;\n    -webkit-box-pack: center;\n    justify-content: center;\n    text-overflow: ellipsis;\n    transition: all 0.2s ease 0s;\n    white-space: nowrap;\n\n    &.active,\n    &:hover {\n      border-bottom-color: var(--control-border-selected);\n      color: var(--control-text-selected);\n    }\n\n    &:not(:first-child) {\n      border-left: var(--border-b-seed) solid var(--control-border-default);\n    }\n\n    a {\n      color: inherit;\n      text-decoration: none;\n      outline: none;\n      display: block;\n      width: 100%;\n      height: 100%;\n      text-align: center;\n      padding: calc(var(--layout-soybean) - var(--border-b-seed))\n        var(--layout-spoon)\n        calc(var(--layout-soybean) - var(--border-b-soybean));\n      margin: var(--layout-sandgrain);\n    }\n  }\n}\n\n@mixin basic-link {\n  text-decoration: none;\n  font: var(--body-xs-medium);\n  color: var(--action-text-primary);\n  padding: var(--layout-seed);\n  margin: calc(-1 * var(--layout-seed));\n  border-radius: var(--border-r-seed);\n  transition: all 0.2s ease 0s;\n  border-width: var(--border-b-sandgrain);\n\n  &:visited {\n    color: var(--action-text-visited);\n    text-decoration: underline;\n  }\n\n  &:active {\n    text-decoration: underline;\n  }\n\n  &:focus {\n    color: var(--action-text-focus);\n    outline: var(--border-b-stamp) solid var(--action-border-focus-ring);\n    text-decoration: underline;\n  }\n\n  &:hover {\n    color: var(--action-text-hover);\n    text-decoration: underline;\n  }\n}\n\n@mixin inline-link {\n  @include basic-link;\n}\n\n@mixin text-status {\n  border-radius: var(--border-r-pill);\n  font: var(--legacy-sm);\n  white-space: nowrap;\n  display: inline-flex;\n  -webkit-box-align: center;\n  align-items: center;\n  color: var(--control-text-primary);\n  background-color: var(--control-bg-secondary);\n  border: var(--border-b-sandgrain);\n  padding: var(--layout-seed) var(--layout-soybean);\n}\n\n@mixin text-centered {\n  text-align: center;\n}\n\n@mixin outline-button {\n  border: var(--border-b-seed) solid var(--legacy-action-border-default);\n  background-color: var(--action-bg-secondary);\n  box-shadow: var(--control-e-sandgrain);\n  color: var(--legacy-action-text-default);\n\n  display: inline-flex;\n  -webkit-box-align: center;\n  align-items: center;\n  text-align: center;\n  cursor: pointer;\n  padding: calc(var(--layout-seed) - var(--border-b-seed))\n    calc(var(--layout-soybean) - var(--border-b-seed));\n  font: var(--legacy-sm);\n  border-radius: var(--border-r-seed);\n  transition: background-color 0.2s ease 0s, border-color, box-shadow;\n\n  &:active {\n    box-shadow: var(--control-e-spoon);\n    border-color: var(--legacy-action-border-pressed);\n    color: var(--legacy-action-text-pressed);\n    text-decoration: underline;\n  }\n\n  &:focus {\n    border-color: var(--legacy-action-border-focus);\n    box-shadow: var(--control-e-spoon);\n    color: var(--legacy-action-text-focus);\n    outline: var(--border-b-stamp) solid var(--action-border-focus-ring);\n    text-decoration: underline;\n  }\n\n  &:hover {\n    border-color: var(--legacy-action-border-hover);\n    box-shadow: var(--control-e-spoon);\n    color: var(--legacy-action-text-hover);\n    text-decoration: underline;\n  }\n}\n\n@mixin text-heading-two {\n  font: var(--heading-md);\n  color: var(--base-text-primary);\n  letter-spacing: -0.0125rem;\n  margin: var(--layout-sandgrain);\n}\n\n@mixin text-heading-three {\n  font: var(--heading-sm);\n  color: var(--base-text-primary);\n  letter-spacing: -0.00625rem;\n  margin: var(--layout-sandgrain);\n}\n\n@mixin text-heading-four {\n  font: var(--heading-xs);\n  color: var(--base-text-primary);\n  margin: var(--layout-sandgrain);\n}\n\n@mixin primary-button {\n  display: inline-flex;\n  -webkit-box-align: center;\n  align-items: center;\n  text-align: center;\n  cursor: pointer;\n  padding: calc(var(--layout-seed) - var(--border-b-seed))\n    calc(var(--layout-stamp) - var(--border-b-seed));\n  font: var(--body-xs);\n  border-radius: var(--border-r-seed);\n  transition: background-color 0.2s ease 0s, border-color, box-shadow;\n\n  color: var(--action-text-oninvert-primary);\n  border: var(--border-b-seed) solid transparent;\n  background-color: var(--action-bg-primary);\n  box-shadow: var(--control-e-sandgrain);\n\n  &:hover {\n    background-color: var(--action-bg-hover);\n    border-color: var(--action-border-hover);\n    color: var(--action-text-oninvert-hover);\n    box-shadow: none;\n    text-decoration: none;\n  }\n\