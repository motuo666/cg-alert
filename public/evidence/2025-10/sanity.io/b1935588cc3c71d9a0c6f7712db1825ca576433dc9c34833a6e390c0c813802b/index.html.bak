8\"],\"text\":\"Increased quota add-on\"},{\"_key\":\"66c30e9f37e64\",\"_type\":\"span\",\"marks\":[],\"text\":\" to extend the included quota of the Growth plan for API CDN requests, API requests, bandwidth, assets, and documents.\"}],\"markDefs\":[{\"_key\":\"e63efd373b08\",\"_type\":\"link\",\"href\":\"https://sanity.io/pricing#add-ons\"},{\"_key\":\"e63efd373b08\",\"_type\":\"link\",\"href\":\"/pricing#add-ons\"}],\"style\":\"normal\"}]}]\n"])</script><script>self.__next_f.push([1,"81:[\"$\",\"$L7e\",\"d98d6a7fdc94\",{\"question\":\"Can I add additional features to my Growth plan?\",\"id\":\"faq-d98d6a7fdc94\",\"answer\":[{\"_key\":\"c5c20e635504\",\"_type\":\"block\",\"children\":[{\"_key\":\"06da79bb371d0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Yes, we offer several \"},{\"_key\":\"06da79bb371d1\",\"_type\":\"span\",\"marks\":[\"9302a7853185\"],\"text\":\"paid add-ons\"},{\"_key\":\"06da79bb371d2\",\"_type\":\"span\",\"marks\":[],\"text\":\" that let you extend your Growth plan with enterprise-grade features.\"}],\"markDefs\":[{\"_key\":\"9302a7853185\",\"_type\":\"link\",\"href\":\"/pricing#add-ons\"},{\"_key\":\"4c97e3ed62c1\",\"_type\":\"link\",\"href\":\"https://www.sanity.io/docs/growth-plan-add-ons\"}],\"style\":\"normal\"},{\"_key\":\"ebae4c70307b\",\"_type\":\"block\",\"children\":[{\"_key\":\"06da79bb371d3\",\"_type\":\"span\",\"marks\":[\"4c97e3ed62c1\"],\"text\":\"Learn more about Growth plan add-ons\"},{\"_key\":\"06da79bb371d4\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"4c97e3ed62c1\",\"_type\":\"link\",\"href\":\"/docs/growth-plan-add-ons\"}],\"style\":\"normal\"}]}]\n"])</script><script>self.__next_f.push([1,"82:[\"$\",\"$L7e\",\"a49d769b049f\",{\"question\":\"How are add-ons billed?\",\"id\":\"faq-a49d769b049f\",\"answer\":[{\"_key\":\"51f8163d4fe8\",\"_type\":\"block\",\"children\":[{\"_key\":\"63b1cfe2db4b0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Add-ons are available for Growth plan projects and will be billed in the subsequent billing cycle as a line item on your invoice.\"}],\"markDefs\":[{\"_key\":\"c7adaa9904e9\",\"_type\":\"link\",\"href\":\"https://www.sanity.io/contact/billing?ref=pricing-faq\"}],\"style\":\"normal\"},{\"_key\":\"438245f878ed\",\"_type\":\"block\",\"children\":[{\"_key\":\"e7a34504fabb\",\"_type\":\"span\",\"marks\":[],\"text\":\"If you purchased an add-on by mistake, you can \"},{\"_key\":\"63b1cfe2db4b1\",\"_type\":\"span\",\"marks\":[\"c7adaa9904e9\"],\"text\":\"contact our account support team\"},{\"_key\":\"63b1cfe2db4b2\",\"_type\":\"span\",\"marks\":[],\"text\":\" who will look into the case for you. Remember to attach your project ID.\"}],\"markDefs\":[{\"_key\":\"c7adaa9904e9\",\"_type\":\"link\",\"href\":\"/contact/billing?ref=pricing-faq\"}],\"style\":\"normal\"}]}]\n"])</script><script>self.__next_f.push([1,"83:[\"$\",\"$L7e\",\"427785a5fdd1\",{\"question\":\"Is there a free trial of Sanity’s paid features?\",\"id\":\"faq-427785a5fdd1\",\"answer\":[{\"_key\":\"3ee7cbf38200\",\"_type\":\"block\",\"children\":[{\"_key\":\"b6a5ebb842c30\",\"_type\":\"span\",\"marks\":[],\"text\":\"Yes, every new project created automatically gets access to additional paid features for a limited period of time, all for free.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"507519550747\",\"_type\":\"block\",\"children\":[{\"_key\":\"b6a5ebb842c31\",\"_type\":\"span\",\"marks\":[\"edc87cc2e3fb\"],\"text\":\"Learn more about the Growth plan trial\"},{\"_key\":\"b6a5ebb842c32\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"edc87cc2e3fb\",\"_type\":\"link\",\"href\":\"/docs/growth-plan-trial\"}],\"style\":\"normal\"}]}]\n"])</script><script>self.__next_f.push([1,"84:[\"$\",\"$L7e\",\"b7479c7af39c\",{\"question\":\"Do you offer special pricing or discounts for startups?\",\"id\":\"faq-b7479c7af39c\",\"answer\":[{\"_key\":\"e8dd12ca4440\",\"_type\":\"block\",\"children\":[{\"_key\":\"445aaa95852c\",\"_type\":\"span\",\"marks\":[],\"text\":\"Yes, the Sanity Startup Program offers 1-year free access to Sanity's Growth plan for early-stage startups.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"833aa0d6e737\",\"_type\":\"block\",\"children\":[{\"_key\":\"747ec795c677\",\"_type\":\"span\",\"marks\":[\"12a23ff3667e\"],\"text\":\"Read more about the program and how to apply\"},{\"_key\":\"5b40a35692e2\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"12a23ff3667e\",\"_type\":\"link\",\"href\":\"https://www.sanity.io/startups\"}],\"style\":\"normal\"}]}]\n"])</script><script>self.__next_f.push([1,"85:[\"$\",\"$L7e\",\"15eb3fee0a3b\",{\"question\":\"Do you have a non-profit plan\",\"id\":\"faq-15eb3fee0a3b\",\"answer\":[{\"_key\":\"4686f8d0e065\",\"_type\":\"block\",\"children\":[{\"_key\":\"2827790f61b6\",\"_type\":\"span\",\"marks\":[],\"text\":\"Yes, we offer a non-profit plan for eligible organizations.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"2146f3e40cdf\",\"_type\":\"block\",\"children\":[{\"_key\":\"0a10b36641dd\",\"_type\":\"span\",\"marks\":[\"2fdcebfaf89e\"],\"text\":\"Read more about the plan and how to apply\"},{\"_key\":\"dd3f184043b6\",\"_type\":\"span\",\"marks\":[],\"text\":\".\"}],\"markDefs\":[{\"_key\":\"2fdcebfaf89e\",\"_type\":\"link\",\"href\":\"/docs/non-profit-plan\"}],\"style\":\"normal\"}]}]\n86:[\"$\",\"$L7e\",\"8b2869d082c9\",{\"question\":\"Is there a minimum contract duration?\",\"id\":\"faq-8b2869d082c9\",\"answer\":[{\"_key\":\"45080d9a2aea\",\"_type\":\"block\",\"children\":[{\"_key\":\"5e115348e4200\",\"_type\":\"span\",\"marks\":[],\"text\":\"No. We list our prices per month, but you’re never locked into a minimum term.\"}],\"markDefs\":[],\"style\":\"normal\"}]}]\n87:[\"$\",\"$L7e\",\"eba4c6b11899\",{\"question\":\"How do I change my plan?\",\"id\":\"faq-eba4c6b11899\",\"answer\":[{\"_key\":\"53deacc4effc\",\"_type\":\"block\",\"children\":[{\"_key\":\"dd619113c6470\",\"_type\":\"span\",\"marks\":[],\"text\":\"Log into \"},{\"_key\":\"dd619113c6471\",\"_type\":\"span\",\"marks\":[\"3669d9ee2bb4\"],\"text\":\"Manage\"},{\"_key\":\"81c845780d0e\",\"_type\":\"span\",\"marks\":[],\"text\":\", select your project from the \\\"Select project or organization\\\" dropdown, and navigate to the Plan tab. Here, you can see your current plan and change it to your plan of choice.\"}],\"markDefs\":[{\"_key\":\"3669d9ee2bb4\",\"_type\":\"link\",\"href\":\"/manage\"}],\"style\":\"normal\"}]}]\n88:[\"$\",\"$L7e\",\"86a59aface91\",{\"question\":\"What is a project?\",\"id\":\"faq-86a59aface91\",\"answer\":[{\"_key\":\"cd3b559ef83c\",\"_type\":\"block\",\"children\":[{\"_key\":\"a2ae2c8c0a3e0\",\"_type\":\"span\",\"marks\":[],\"text\":\"A project is a self-contained collection of datasets, members, and configuration options such as webhooks and tokens. A member of one project is not automatically granted access to any other, though an administrator memb"])</script><script>self.__next_f.push([1,"er may invite them.\"}],\"markDefs\":[],\"style\":\"normal\"}]}]\n"])</script><script>self.__next_f.push([1,"89:[\"$\",\"$L7e\",\"a3de75a6e122\",{\"question\":\"What is an organization?\",\"id\":\"faq-a3de75a6e122\",\"answer\":[{\"_key\":\"c6f86a54f60d\",\"_type\":\"block\",\"children\":[{\"_key\":\"11124fbe962c0\",\"_type\":\"span\",\"marks\":[],\"text\":\"An organization is an entity where multiple projects are grouped to give them a single billing point. It does not need to be a registered company.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e56b207a8ec6\",\"_type\":\"block\",\"children\":[{\"_key\":\"005768ab29d10\",\"_type\":\"span\",\"marks\":[],\"text\":\"Access to an organization does not imply access to any project under that organization. You must be invited to each project separately.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4553dceb8dfd\",\"_type\":\"block\",\"children\":[{\"_key\":\"788e8edc6afe\",\"_type\":\"span\",\"marks\":[],\"text\":\"Project configuration cannot be shared across projects in an organization, nor can its content be referenced across projects.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"52f37994ccfd\",\"_type\":\"block\",\"children\":[{\"_key\":\"bc5a6304a173\",\"_type\":\"span\",\"marks\":[],\"text\":\"A member may be a member of multiple organizations but must be invited to each. The roles in each project are created uniquely.\"}],\"markDefs\":[],\"style\":\"normal\"}]}]\n"])</script><script>self.__next_f.push([1,"8a:[\"$\",\"$L7e\",\"710b64bfd417\",{\"question\":\"What is a dataset?\",\"id\":\"faq-710b64bfd417\",\"answer\":[{\"_key\":\"5512958c9e0f\",\"_type\":\"block\",\"children\":[{\"_key\":\"5e4d9cc384440\",\"_type\":\"span\",\"marks\":[],\"text\":\"A dataset is a collection of JSON documents that can be of different types and have references to each other. You can think of a dataset as a “database” where all of your content is stored, whereas the document‘s types would constitute “tables”.\"}],\"markDefs\":[],\"style\":\"normal\"}]}]\n8b:[\"$\",\"$L7e\",\"c242681d08b7\",{\"question\":\"What is a content type?\",\"id\":\"faq-c242681d08b7\",\"answer\":[{\"_key\":\"b4d7401f8c7f\",\"_type\":\"block\",\"children\":[{\"_key\":\"f3e6e661855d0\",\"_type\":\"span\",\"marks\":[],\"text\":\"While datasets are like “databases” that store your content, you can think of content types as the “tables” in your database.\"}],\"markDefs\":[],\"style\":\"normal\"}]}]\n8c:[\"$\",\"$L7e\",\"cebbbbcd4499\",{\"question\":\"What is a billing cycle?\",\"id\":\"faq-cebbbbcd4499\",\"answer\":[{\"_key\":\"9b3658fc0f26\",\"_type\":\"block\",\"children\":[{\"_key\":\"2990c6bac54b0\",\"_type\":\"span\",\"marks\":[],\"text\":\"A billing cycle is the period of time between two invoices. The cycle starts on the first day of the month and ends on the last day.\"}],\"markDefs\":[],\"style\":\"normal\"}]}]\n8d:[\"$\",\"$L7e\",\"80bfea0bcffe\",{\"question\":\"What currency can I pay in?\",\"id\":\"faq-80bfea0bcffe\",\"answer\":[{\"_key\":\"0912e6c2162d\",\"_type\":\"block\",\"children\":[{\"_key\":\"7114592d39860\",\"_type\":\"span\",\"marks\":[],\"text\":\"You can pay in any currency as long as your credit card provider allows charging in USD after conversion.\"}],\"markDefs\":[],\"style\":\"normal\"}]}]\n"])</script><script>self.__next_f.push([1,"8e:[\"$\",\"$L7e\",\"ca86baa4cb4e\",{\"question\":\"Can I pay by invoice?\",\"id\":\"faq-ca86baa4cb4e\",\"answer\":[{\"_key\":\"1254750ae93d\",\"_type\":\"block\",\"children\":[{\"_key\":\"1ae1fc5b756a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Pay by invoice is only available for our \"},{\"_key\":\"1ae1fc5b756a1\",\"_type\":\"span\",\"marks\":[\"e753160eeb2d\"],\"text\":\"Enterprise plan\"},{\"_key\":\"1ae1fc5b756a2\",\"_type\":\"span\",\"marks\":[],\"text\":\". Please \"},{\"_key\":\"1ae1fc5b756a3\",\"_type\":\"span\",\"marks\":[\"f3c445dedd59\"],\"text\":\"contact our sales team\"},{\"_key\":\"1ae1fc5b756a4\",\"_type\":\"span\",\"marks\":[],\"text\":\" for more information.\"}],\"markDefs\":[{\"_key\":\"e753160eeb2d\",\"_type\":\"link\",\"href\":\"/enterprise?ref=pricing-faq\"},{\"_key\":\"f3c445dedd59\",\"_type\":\"link\",\"href\":\"/contact/sales?ref=pricing-faq\"}],\"style\":\"normal\"}]}]\n"])</script><script>self.__next_f.push([1,"8f:[\"$\",\"$L7e\",\"f08d6d28caf0\",{\"question\":\"Can I pay using another method for my plan?\",\"id\":\"faq-f08d6d28caf0\",\"answer\":[{\"_key\":\"6abc0aaccc88\",\"_type\":\"block\",\"children\":[{\"_key\":\"00a260d7e5950\",\"_type\":\"span\",\"marks\":[],\"text\":\"No, we do not support external payment providers, third-party payment services, invoicing using bank payments, or any other non-card-type payments. Pay by invoice is only available for our \"},{\"_key\":\"00a260d7e5951\",\"_type\":\"span\",\"marks\":[\"7d7671c383dd\"],\"text\":\"Enterprise plan\"},{\"_key\":\"00a260d7e5952\",\"_type\":\"span\",\"marks\":[],\"text\":\". Please \"},{\"_key\":\"00a260d7e5953\",\"_type\":\"span\",\"marks\":[\"7181878b3293\"],\"text\":\"contact our sales team\"},{\"_key\":\"00a260d7e5954\",\"_type\":\"span\",\"marks\":[],\"text\":\" for more information.\"}],\"markDefs\":[{\"_key\":\"7d7671c383dd\",\"_type\":\"link\",\"href\":\"/enterprise?ref=pricing-faq\"},{\"_key\":\"7181878b3293\",\"_type\":\"link\",\"href\":\"/contact/sales?ref=pricing-faq\"}],\"style\":\"normal\"}]}]\n"])</script><script>self.__next_f.push([1,"90:[\"$\",\"$L7e\",\"c468560fcbb3\",{\"question\":\"Can I pay annually?\",\"id\":\"faq-c468560fcbb3\",\"answer\":[{\"_key\":\"7e8b5188f995\",\"_type\":\"block\",\"children\":[{\"_key\":\"ecb1d66efcee0\",\"_type\":\"span\",\"marks\":[],\"text\":\"No, only monthly payments are supported for self-serve plans. You can pay annually if you upgrade to our Enterprise plan. Please \"},{\"_key\":\"ecb1d66efcee1\",\"_type\":\"span\",\"marks\":[\"9f2a93f9258f\"],\"text\":\"contact our sales team\"},{\"_key\":\"ecb1d66efcee2\",\"_type\":\"span\",\"marks\":[],\"text\":\" for more information.\"}],\"markDefs\":[{\"_key\":\"9f2a93f9258f\",\"_type\":\"link\",\"href\":\"/contact/sales?ref=pricing-faq\"}],\"style\":\"normal\"}]}]\n"])</script><script>self.__next_f.push([1,"91:[\"$\",\"$L7e\",\"52897e8b91a1\",{\"question\":\"How do I update my payment method?\",\"id\":\"faq-52897e8b91a1\",\"answer\":[{\"_key\":\"fab539cc2a5e\",\"_type\":\"block\",\"children\":[{\"_key\":\"b83b292ae55b0\",\"_type\":\"span\",\"marks\":[],\"text\":\"It is important that you are navigating to the Sanity Manage \"},{\"_key\":\"b83b292ae55b1\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"organization’s page\"},{\"_key\":\"b83b292ae55b2\",\"_type\":\"span\",\"marks\":[],\"text\":\" and not the \"},{\"_key\":\"b83b292ae55b3\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"project page\"},{\"_key\":\"b83b292ae55b4\",\"_type\":\"span\",\"marks\":[],\"text\":\" (as there are no billing details on the project page).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"26513e7ff49e\",\"_type\":\"block\",\"children\":[{\"_key\":\"bce5083a2a900\",\"_type\":\"span\",\"marks\":[],\"text\":\"As an \"},{\"_key\":\"bce5083a2a901\",\"_type\":\"span\",\"marks\":[\"em\",\"strong\"],\"text\":\"Organization\"},{\"_key\":\"bce5083a2a902\",\"_type\":\"span\",\"marks\":[],\"text\":\" administrator log into \"},{\"_key\":\"bce5083a2a903\",\"_type\":\"span\",\"marks\":[\"44a94821759f\"],\"text\":\"https://www.sanity.io/manage\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[{\"_key\":\"44a94821759f\",\"_type\":\"link\",\"href\":\"https://www.sanity.io/manage\"}],\"style\":\"normal\"},{\"_key\":\"582f08876949\",\"_type\":\"block\",\"children\":[{\"_key\":\"618eb3ec315b0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Click on the \"},{\"_key\":\"618eb3ec315b1\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Select Project or Organization\"},{\"_key\":\"618eb3ec315b2\",\"_type\":\"span\",\"marks\":[],\"text\":\" dropdown on the top left\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6f51d6fd1e57\",\"_type\":\"block\",\"children\":[{\"_key\":\"dd478dbebcdf0\",\"_type\":\"span\",\"marks\":[],\"text\":\"Click on the \"},{\"_key\":\"dd478dbebcdf1\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"organization’s name\"},{\"_key\":\"dd478dbebcdf2\",\"_type\":\"span\",\"marks\":[],\"text\":\" (not the project)\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"65eff6a39a1f\",\"_type\":\"block\",\"children\":[{\"_key\":\"af34b5872e680\",\"_type\":\"span\",\"marks\":[],\"text\":\"Select the \"},{\"_key\":\"af34b5872e681\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Billing tab\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"6566bf9deecd\",\"_type\":\"block\",\"children\":[{\"_key\":\"aa94a495fe260\",\"_type\":\"span\",\"marks\":[],\"text\":\"Click on \"},{\"_key\":\"aa94a495fe261\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Change Billing Information\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"e70b0ce97afe\",\"_type\":\"block\",\"children\":[{\"_key\":\"da4b6636b7280\",\"_type\":\"span\",\"marks\":[],\"text\":\"Click on the \"},{\"_key\":\"da4b6636b7281\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Pencil icon\"},{\"_key\":\"da4b6636b7282\",\"_type\":\"span\",\"marks\":[],\"text\":\" to change existing \"},{\"_key\":\"da4b6636b7283\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Payment Method\"},{\"_key\":\"da4b6636b7284\",\"_type\":\"span\",\"marks\":[],\"text\":\" or click on \"},{\"_key\":\"da4b6636b7285\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Add Payment Method\"},{\"_key\":\"da4b6636b7286\",\"_type\":\"span\",\"marks\":[],\"text\":\" if one does not exist\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"805c43bc26e6\",\"_type\":\"block\",\"children\":[{\"_key\":\"94d498faafc60\",\"_type\":\"span\",\"marks\":[],\"text\":\"Update card details\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"db3e6b93f0fb\",\"_type\":\"block\",\"children\":[{\"_key\":\"0c245af8280a0\",\"_type\":\"span\",\"marks\":[],\"text\":\"If you instead see tabs like Plan, Usage, Access, Datasets, etc., it means you’re on a \"},{\"_key\":\"0c245af8280a1\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"project\"},{\"_key\":\"0c245af8280a2\",\"_type\":\"span\",\"marks\":[],\"text\":\" (rather than the \"},{\"_key\":\"0c245af8280a3\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"organization\"},{\"_key\":\"0c245af8280a4\",\"_type\":\"span\",\"marks\":[],\"text\":\") page, in which case there should be a small hyperlink to the organization above the large project name at the top of the page.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"4124deff96cf\",\"_type\":\"block\",\"children\":[{\"_key\":\"18561a6394630\",\"_type\":\"span\",\"marks\":[],\"text\":\"If you do not have access to the organization or if your role in the organization is anything other than Administrator or Billing Manager you will be unable to make any billing-related changes to the organization.\"}],\"markDefs\":[],\"style\":\"normal\"}]}]\n"])</script><script>self.__next_f.push([1,"92:[\"$\",\"$L7e\",\"cef798156bc3\",{\"question\":\"How can I adjust who has admin privileges?\",\"id\":\"faq-cef798156bc3\",\"answer\":[{\"_key\":\"0866deee267a\",\"_type\":\"block\",\"children\":[{\"_key\":\"72f30fabf40e0\",\"_type\":\"span\",\"marks\":[\"364b18be3801\"],\"text\":\"Log into Manage\"},{\"_key\":\"72f30fabf40e1\",\"_type\":\"span\",\"marks\":[],\"text\":\", select your project from the “Select project or organization” dropdown, and navigate to the Members tab. Here, you can assign access levels for each user.\"}],\"markDefs\":[{\"_key\":\"364b18be3801\",\"_type\":\"link\",\"href\":\"/manage\"}],\"style\":\"normal\"}]}]\n"])</script><script>self.__next_f.push([1,"93:[\"$\",\"$L7e\",\"19fedc314111\",{\"question\":\"How do I become an Organization Administrator?\",\"id\":\"faq-19fedc314111\",\"answer\":[{\"_key\":\"324a8adb1d24\",\"_type\":\"block\",\"children\":[{\"_key\":\"236dfdf38c9d0\",\"_type\":\"span\",\"marks\":[],\"text\":\"You must ask a current Organization Administrator to \"},{\"_key\":\"236dfdf38c9d1\",\"_type\":\"span\",\"marks\":[\"765d7f0a5373\"],\"text\":\"log into Manage\"},{\"_key\":\"569228b9c843\",\"_type\":\"span\",\"marks\":[],\"text\":\", select the organization in the \\\"Select project or organization\\\" dropdown, and then navigate to the Members tab. Here, they can modify your user role.\"}],\"markDefs\":[{\"_key\":\"765d7f0a5373\",\"_type\":\"link\",\"href\":\"/manage\"}],\"style\":\"normal\"}]}]\n"])</script><script>self.__next_f.push([1,"94:[\"$\",\"$L7e\",\"b0455bc54d86\",{\"question\":\"How do I update the Billing Contact information?\",\"id\":\"faq-b0455bc54d86\",\"answer\":[{\"_key\":\"8ed0cdac59a1\",\"_type\":\"block\",\"children\":[{\"_key\":\"b7038f8f00bc0\",\"_type\":\"span\",\"marks\":[],\"text\":\"It is important that you are navigating to the Sanity Manage \"},{\"_key\":\"b7038f8f00bc1\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"organization's page\"},{\"_key\":\"b7038f8f00bc2\",\"_type\":\"span\",\"marks\":[],\"text\":\" and not the \"},{\"_key\":\"b7038f8f00bc3\",\"_type\":\"span\",\"marks\":[\"em\"],\"text\":\"project page\"},{\"_key\":\"b7038f8f00bc4\",\"_type\":\"span\",\"marks\":[],\"text\":\" (as there are no billing details on the project page).\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"d3817a6aab19\",\"_type\":\"block\",\"children\":[{\"_key\":\"2a6488f0c6870\",\"_type\":\"span\",\"marks\":[],\"text\":\"As an \"},{\"_key\":\"2a6488f0c6871\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Organization\"},{\"_key\":\"2a6488f0c6872\",\"_type\":\"span\",\"marks\":[],\"text\":\" administrator log into \"},{\"_key\":\"2a6488f0c6873\",\"_type\":\"span\",\"marks\":[\"4a02ad72c192\"],\"text\":\"https://www.sanity.io/manage\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[{\"_key\":\"4a02ad72c192\",\"_type\":\"link\",\"href\":\"https://www.sanity.io/manage\"}],\"style\":\"normal\"},{\"_key\":\"aefd23b5895a\",\"_type\":\"block\",\"children\":[{\"_key\":\"766e5ed5f7380\",\"_type\":\"span\",\"marks\":[],\"text\":\"Click on the Select Project or Organization dropdown on the top left\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"0b5fd5ddd715\",\"_type\":\"block\",\"children\":[{\"_key\":\"191bba000ca50\",\"_type\":\"span\",\"marks\":[],\"text\":\"Click on the \"},{\"_key\":\"191bba000ca51\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"organization's name\"},{\"_key\":\"191bba000ca52\",\"_type\":\"span\",\"marks\":[],\"text\":\" (not the project)\"}],\"level\":1,\"listItem\":\"number\",\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"c3ae340d2a4b\",\"_type\":\"block\",\"children\":[{\"_key\"