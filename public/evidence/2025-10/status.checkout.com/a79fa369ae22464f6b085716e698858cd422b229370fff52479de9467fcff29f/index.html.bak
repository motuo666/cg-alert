w;\n    gap: var(--layout-stamp);\n  }\n\n  .environment-switch-container {\n    display: flex;\n    flex-wrap: nowrap;\n\n    @media only screen and (max-width: 512px) {\n      display: block;\n      flex-wrap: unset;\n    }\n  }\n\n  .environment-tag {\n    display: flex;\n    height: var(--layout-shoe);\n    gap: var(--layout-stamp);\n    border-radius: var(--border-r-seed);\n    margin-top: var(--layout-seed);\n    background-color: var(--control-bg-emphasis-selected);\n    padding: calc(var(--layout-soybean) - var(--border-b-seed))\n      var(--layout-soybean);\n    justify-content: center;\n    align-items: center;\n    white-space: nowrap;\n\n    font-weight: 700;\n    font-size: 11px;\n    font-family: "Roboto Mono", SF Mono, ui-monospace, "Cascadia Code",\n      "Source Code Pro", Menlo, Consolas, "DejaVu Sans Mono", monospace;\n\n    color: var(--base-text-oninvert-primary);\n    font-style: normal;\n    line-height: 100%;\n    letter-spacing: 1.32px;\n    text-transform: var(--text-loud);\n  }\n\n  .auth-container {\n    width: 100%;\n    max-width: 700px;\n\n    @media only screen and (max-width: 1024px) {\n      max-width: 100%;\n    }\n  }\n\n  .cko-login-container {\n    display: flex;\n    justify-content: space-between;\n    width: 100%;\n  }\n\n  .cko-login-footer {\n    width: 100%;\n\n    .cko-environment-switch-link {\n      display: flex;\n      flex-wrap: nowrap;\n      white-space: nowrap;\n      align-items: center;\n      color: var(--control-text-primary);\n      text-align: right;\n      font-style: normal;\n      text-decoration: none;\n      margin-right: var(--layout-saxophone);\n\n      &:visited,\n      &:active,\n      &:focus,\n      &:hover {\n        text-decoration: underline;\n      }\n\n      svg {\n        margin-left: var(--layout-soybean);\n      }\n\n      @media only screen and (max-width: 512px) {\n        margin-bottom: var(--layout-soybean);\n      }\n    }\n  }\n\n  .auth-content-inner {\n    border: none;\n    paddin