############################
# Runtime / platform noise #
############################

# Node runtime junk
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock
package-lock.json
pnpm-lock.yaml

# macOS / OS junk
.DS_Store
.DS_Store?
Thumbs.db

#####################
# Build artifacts   #
#####################

# Local scratch / tmp dirs
.tmp/
.temp/
tmp/
*.tmp

# Build output / bundles / compiled assets
dist/
build/

# Cache dirs (runner local, crawler temp, etc.)
.cache/
.cache/**

# Coverage / test output
coverage/

########################################
# Secrets / local config (never commit)
########################################

.env
.env.*
!.env.example

#########################
# Generated junk to nuke
#########################

# HTML safety copies / debug leftovers
*.bak

#####################################
# Data / site content we KEEP (repo = proof)
#####################################

# Do NOT ignore core evidence/output.
!evidence/
!vendors/
!updates/
!reports/
!public/

# Poller runtime state (not tracked; reduces git conflicts)
evidence/.pending/
evidence/.confirmed/
evidence/_last_poll.json

