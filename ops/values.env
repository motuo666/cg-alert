# ops/values.env — email-only minimal
SITE_ORIGIN="https://www.cg-alert.com"
WORKER_URL="https://api.cg-alert.com"
UNSUB_ORIGIN="https://api.cg-alert.com"

MAIL_FROM="Jason — CG Alert <ops@cg-alert.com>"
REPLY_TO="Jason <jason@cg-alert.com>"
MAIL_POSTAL_ADDRESS="Your address here"

# Optional but recommended
STRIPE_LINK_PORTFOLIO="https://buy.stripe.com/..."
STRIPE_LINK_BUSINESS="https://buy.stripe.com/..."
INTAKE_FORM_URL="https://forms.gle/..."

# RAMP & risk guard — keep defaults if unsure
DOMAIN_LIMIT="2"
SEND_SPACING_MS="1200"
ERROR_ABORT_THRESHOLD="3"
ERROR_ABORT_WINDOW="10"
SEED_SEND="true"
RAMP_BASE="12"
RAMP_WEEKLY_INCREMENT="8"
RAMP_MAX="100"
